[Unit]
Description=NOCT Brief external PostgreSQL backup
After=network.target postgresql.service
[Service]
Type=oneshot
User=noct
Group=noct
WorkingDirectory=/opt/noct/current
EnvironmentFile=/etc/noct/environment
ExecStart=/usr/local/bin/node --import tsx scripts/ops/backup.ts
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
