[Unit]
Description=NOCT Brief scheduled worker
After=network.target postgresql.service
[Service]
Type=oneshot
User=noct
Group=noct
WorkingDirectory=/opt/noct/current
EnvironmentFile=/etc/noct/environment
ExecStart=/usr/local/bin/node --import tsx scripts/worker.ts
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
