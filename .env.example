# NOCT Brief 환경 설정
# 처음 클론했다면 Node.js 24에서 npm ci를 실행하세요. 공개 샘플 화면은 아래 기본값으로 볼 수 있습니다.
# 값을 입력할 때는 이 파일을 프로젝트 루트의 .env.local로 복사하세요. 기존 .env.local이 있으면 필요한 항목만 추가합니다.
# 실제 키와 비밀번호는 로컬에서는 .env.local에, 운영에서는 서버의 /etc/noct/environment에 저장합니다.
# 설정을 바꾼 뒤에는 해당 앱 프로세스를 다시 시작하세요. 실행 절차는 README.md, 서버 구성은 docs/OPERATIONS.md에 있습니다.

# 실행 환경과 데이터
# 앱이 적용할 환경 규칙입니다. 개발은 local, 운영은 production을 사용합니다.
# production에서는 DATA_MODE=live, DATABASE_URL, HTTPS로 시작하는 BETTER_AUTH_URL이 필수입니다.
APP_ENV=local

# sample은 가상 자료로 화면과 발행 흐름을 시험합니다. live는 실제 자료를 처리합니다.
# DB를 사용하면 앱의 환경과 데이터 모드가 마이그레이션 때 저장한 DB 표식과 일치해야 합니다.
DATA_MODE=sample

# DB 연결이 비어 있으면 공개 화면에 읽기 전용 샘플을 표시합니다. 저장·관리자 로그인에는 PostgreSQL이 필요합니다.
# 로컬은 npm run db:local이 127.0.0.1:55432에 DB를 띄우고 빈 연결 값을 .env.local에 채웁니다.
# 직접 지정할 때의 형식은 postgresql://USER:PASSWORD@HOST:PORT/DB_NAME입니다. 비밀번호의 URI 특수문자는 인코딩합니다.
# 로컬에서는 loopback 주소와 _local로 끝나는 DB 이름을 사용합니다. 운영에는 운영 전용 DB 연결 문자열을 넣습니다.
DATABASE_URL=

# Google 관리자 로그인
# 로그인과 콜백에 쓸 앱의 기본 주소입니다. 로컬에서는 관리자 화면도 http://localhost:3000/admin으로 엽니다.
# 운영은 실제 HTTPS 주소를 넣고, Google Cloud에는 각 환경의 웹 원본과 아래 콜백 주소를 등록합니다.
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud에서 환경별로 발급한 웹 애플리케이션 OAuth 클라이언트 ID입니다.
# 승인된 리디렉션 URI는 BETTER_AUTH_URL 뒤에 /api/auth/callback/google을 붙인 주소입니다.
GOOGLE_CLIENT_ID=
# 위와 같은 OAuth 클라이언트의 보안 비밀입니다. 관리자 로그인을 사용하려면 ID와 함께 입력합니다.
GOOGLE_CLIENT_SECRET=

# 세션 보호와 OAuth 토큰 암호화에 쓰는 비밀키입니다. 환경별로 최소 32자의 난수를 한 번 생성해 보관합니다.
# 생성 예시 (로컬 터미널): node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# 관리 권한을 받을 한 사람의 Google 계정 식별자(sub)입니다. 최초 설정 때는 비워 두고
# 운영자 계정으로 /admin에 로그인한 뒤, 화면에 표시된 sub를 여기에 입력하고 앱을 재시작합니다.
ADMIN_GOOGLE_SUB=

# 리포트 생성과 예약 발행
# 운영 서버가 시작할 때 예약 발행과 발행 예외 알림 재시도를 등록합니다.
# 켜려면 production/live와 EXTERNAL_CALLS_ENABLED=true가 필요합니다. 로컬에서는 false로 둡니다.
AUTO_PUBLISH_ENABLED=false

# 실제 생성 API 호출을 허용하는 스위치입니다. 모델·비용을 확인한 live 환경에서 true로 설정합니다.
# 로컬 샘플을 확인할 때는 false로 둡니다. 이 스위치는 텔레그램 전송과 별개입니다.
EXTERNAL_CALLS_ENABLED=false

# OpenAI 프로젝트의 서버용 키입니다. 비공개 시험에는 Restricted에서 Responses 생성·조회 권한을 줍니다.
# report:trial의 --run은 이 프로세스에서만 외부 생성을 켭니다. 로컬 앱 스위치는 false로 둡니다.
OPENAI_API_KEY=
# 해당 프로젝트에서 사용할 수 있고 비용을 확인한 API 모델 ID를 입력합니다. 실제 생성에는 키와 모델 ID가 모두 필요합니다.
# 비공개 시험과 정규 작업의 작성·보정 모델입니다. 설정은 유료 재시험이나 운영 발행을 켜지 않습니다.
OPENAI_MODEL=gpt-6-astra
# 비공개 시험의 독립 근거 검증·재검증 모델입니다. 비워 두면 작성 모델을 사용합니다.
OPENAI_VERIFICATION_MODEL=gpt-6.2-sol
# 생성 요청의 추론 강도입니다. 허용값은 low, medium, high입니다.
OPENAI_REASONING_EFFORT=medium
# 생성 요청 한 건의 최대 출력 토큰 수입니다. 1000~24000 사이의 정수를 사용합니다.
OPENAI_MAX_OUTPUT_TOKENS=10000

# 비공개 장후 조사 시험 전용입니다. 작성·보정·검증 모델과 출력 설정은 위 항목을 사용합니다.
OPENAI_RESEARCH_MODEL=gpt-6.2-sol
# 조사 강도는 low, medium, high, xhigh를 허용합니다. 비교 실행은 지정된 모델·강도 조합을 사용합니다.
OPENAI_RESEARCH_REASONING_EFFORT=high
# 추론과 JSON 출력을 합한 상한은 1000~64000, 검색·열람·찾기 호출 합계는 1~80입니다.
OPENAI_RESEARCH_MAX_OUTPUT_TOKENS=32000
OPENAI_RESEARCH_MAX_TOOL_CALLS=40

# 시장 데이터 공급원
# 공급원 이름을 넣을 예약 항목입니다. 현재 외부 공급원을 직접 호출하는 수집기는 없어 비워 둡니다.
MARKET_DATA_PROVIDER=
# 해당 공급원의 서버용 API 키를 보관할 예약 항목입니다. 공급원·공개 이용권·연동 방식 확정 후 설정합니다.
MARKET_DATA_API_KEY=

# 텔레그램 예외 알림
# 운영에서 조치가 필요한 리포트·백업 예외를 보낼 때 true로 설정합니다. 토큰과 수신 대화 ID가 모두 필요합니다.
# 리포트 알림은 자동 발행, 백업 알림은 자동 백업이 켜져 있어야 전송합니다. 로컬 자동 전송은 false로 둡니다.
TELEGRAM_ENABLED=false
# 텔레그램의 공식 @BotFather에 /newbot을 보내 봇을 만든 뒤 발급된 토큰 전체(숫자, 콜론, 뒤쪽 문자열)를 입력합니다.
TELEGRAM_BOT_TOKEN=
# 운영자가 만든 봇의 개인 대화에서 시작을 누릅니다. Bot API의 getUpdates 응답에서 본인이 보낸 메시지를 찾아
# message.chat.type이 private인지 확인한 뒤 같은 메시지의 message.chat.id 숫자를 입력합니다.
# 공식 API 안내: https://core.telegram.org/bots/api#getupdates
TELEGRAM_CHAT_ID=

# DB 백업과 복원
# 운영의 일일 DB 백업과 백업 지연 점검을 켭니다. 첫 성공 전에는 감시 시작부터, 이후에는 마지막 성공부터 26시간을 셉니다.
# 발행과 독립적으로 켤 수 있습니다. 운영 백업 서비스·타이머와 아래 버킷을 준비한 뒤 true로 설정합니다.
AUTO_BACKUP_ENABLED=false
# 백업을 업로드할 비공개 S3 버킷의 이름만 입력합니다. 스크립트가 버킷 안의 noct-db/ 경로를 사용합니다.
# 운영 백업 서비스가 사용할 AWS CLI 자격 증명은 서버에 별도로 설정합니다.
BACKUP_BUCKET=
# pg_dump와 pg_restore 실행 파일이 들어 있는 디렉터리입니다. 비워 두면 .local/pg-client/bin, 그다음 PATH 순서로 찾습니다.
PG_CLIENT_BIN=

# 복원할 때만 사용합니다. 현재 앱 DB와 다른 빈 PostgreSQL DB의 연결 문자열을 입력하고 대상 DB의 다른 연결을 종료합니다.
RESTORE_DATABASE_URL=
# 백업 파일과 복원 대상을 확인한 뒤 복원 명령을 실행할 때만 empty-database로 지정합니다.
CONFIRM_RESTORE=
# 운영 DB의 마이그레이션을 승인하고 npm run db:migrate를 실행할 때만 production으로 지정합니다. 로컬은 비워 둡니다.
CONFIRM_PRODUCTION_MIGRATION=

# HTTP 검사와 운영 도메인
# npm run test:http가 접속할 로컬 서버 주소입니다. localhost 또는 127.0.0.1과 실행 중인 앱의 포트를 사용합니다.
TEST_BASE_URL=http://127.0.0.1:3000
# 운영 Caddy가 HTTPS 요청을 받을 도메인 이름입니다(예: brief.example.com). 서버의 DNS 설정 후 입력합니다.
NOCT_DOMAIN=
