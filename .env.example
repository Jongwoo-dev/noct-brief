# 공개 샘플에는 실제 비밀 값을 넣지 않습니다. 기존 .env.local을 보존하며 복사하세요.
# 운영 값은 서버 비밀 설정에 별도로 등록합니다. 모든 키는 서버 전용입니다.
APP_ENV=local
DATA_MODE=sample
BETTER_AUTH_URL=http://localhost:3000
# 로컬 자동 발행·텔레그램 차단. 외부 API는 별도 명시적 활성화 필요.
AUTO_PUBLISH_ENABLED=false
TELEGRAM_ENABLED=false
EXTERNAL_CALLS_ENABLED=false
# db:local은 비어 있는 항목만 생성. 로컬 loopback 주소와 _local DB 이름 필요.
DATABASE_URL=
# OAuth 콜백: /api/auth/callback/google. 로컬·운영 클라이언트 분리.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 최소 32자 난수. node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# 검증된 Google sub. 미설정 시 /admin에서 자신의 sub만 확인 가능, 관리 권한 없음.
ADMIN_GOOGLE_SUB=
# 세션 키와 다른 최소 32자 난수.
CRON_SECRET=
# 모델·요금 승인 후 사용. 모델 기본값 없음.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=8000
# 공급원·공개 이용권 확정 후 연결할 예약 항목. 현재 직접 API 수집기는 미연결.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
# 운영 예외 알림만. 정상 발행 알림 제외.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 외부 DB 백업 버킷. AWS CLI 인증은 별도 서버 비밀 설정.
BACKUP_BUCKET=
# 빈 값이면 .local/pg-client/bin 또는 PATH 사용.
PG_CLIENT_BIN=
# 현재 앱 DB와 분리된 빈 DB에서만 복원. 다른 연결을 종료하고 empty-database 설정.
RESTORE_DATABASE_URL=
CONFIRM_RESTORE=
# 운영 마이그레이션 실행 시에만 production 설정.
CONFIRM_PRODUCTION_MIGRATION=
TEST_BASE_URL=http://127.0.0.1:3000
# 운영 Caddy 도메인. 실제 DNS·HTTPS·배포는 별도 승인 후.
NOCT_DOMAIN=
