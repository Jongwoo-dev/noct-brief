{
  "name": "noct-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "assets:brand": "tsx scripts/generate-brand-assets.ts",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:http": "tsx scripts/test-http.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "check": "npm run typecheck && npm test && npm run test:integration && npm run build",
    "release:package": "tsx scripts/ops/package-release.ts",
    "format:check": "prettier --check app components lib data scripts tests instrumentation.ts next.config.ts vitest.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "lucide-react": "1.66.0",
    "luxon": "3.7.2",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
